# =============================================================================
# MEST BDT Web - Local Development Environment
# =============================================================================
# Copy this file to .env.local and update the values as needed.
#   cp .env.example .env.local
#
# Run the supporting services (API, DBs, Auth, Openinary) with:
#   docker compose -f deployment/frontend.yml up
# Then start the web app locally with:
#   npm run dev

# -----------------------------------------------------------------------------
# Hanko Auth API (Public)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_HANKO_API_URL=http://localhost:8000

# -----------------------------------------------------------------------------
# BDT Backend API (Public)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_BDT_API_URL=http://localhost:3001