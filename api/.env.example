# =============================================================================
# MEST BDT API - Local Development Environment
# =============================================================================
# Copy this file to .env and update the values as needed.
#   cp .env.example .env
#
# Run the supporting services with:
#   docker compose -f deployment/backend.yml up
# Then start the API locally with:
#   npm run start:dev

# -----------------------------------------------------------------------------
# MongoDB
# -----------------------------------------------------------------------------
MONGO_URI=mongodb://localhost:27017/bdt

# -----------------------------------------------------------------------------
# Hanko Auth
# -----------------------------------------------------------------------------
HANKO_API_URL=http://localhost:8000
# Hanko Admin API (used only by `npm run token:hanko`; NOT by the running API).
# Keep this port network-isolated in production — it is unauthenticated.
HANKO_ADMIN_API_URL=http://localhost:8001

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_BASE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Image Uploads (Openinary)
# -----------------------------------------------------------------------------
UPLOAD_PROVIDER=openinary
OPENINARY_URL=http://localhost:3002
OPENINARY_PUBLIC_URL=http://localhost:3002
# Generate an API key after first run from http://localhost:3002
OPENINARY_API_KEY=

# -----------------------------------------------------------------------------
# SMTP (Mailslurper - local dev mail catcher)
# View emails at http://localhost:8080
# -----------------------------------------------------------------------------
SMTP_HOST=localhost
SMTP_PORT=2500
SMTP_SECURE=false
SMTP_USER=test
SMTP_PASS=test
SMTP_FROM=no-reply@example.com
