# =============================================================================
# MEST BDT - Environment Configuration
# =============================================================================
# Copy this file to .env and update the values as needed.
#   cp .env.example .env

# -----------------------------------------------------------------------------
# Auth Database (Postgres)
# -----------------------------------------------------------------------------
# NOTE: POSTGRES_PASSWORD is only applied the FIRST time the auth-db volume is
# created. If you change it later you must recreate the volume, otherwise the
# old password persists and Hanko fails with "password authentication failed":
#   docker compose -f full.yml down -v   # (drops auth_db_data — auth data only)
POSTGRES_USER=hanko
POSTGRES_PASSWORD=hankopassword
POSTGRES_DB=hanko

# -----------------------------------------------------------------------------
# Public Host / Origin
# -----------------------------------------------------------------------------
# APP_HOST is the bare public host of the deployment (no scheme, no port). The
# public-facing URLs below (APP_BASE_URL, BETTER_AUTH_URL, OPENINARY_PUBLIC_URL,
# NEXT_PUBLIC_*) are all derived from it, and it is injected as Hanko's WebAuthn
# Relying Party ID (WEBAUTHN_RELYING_PARTY_ID).
#
#   Local dev:    APP_HOST=localhost  -> URLs resolve to http://localhost:<port>
#   Single host:  APP_HOST=host-or-ip -> URLs resolve to http://<host>:<port>
#
# NOTE: derivation keeps each service's http:// scheme and published port. That
# fits local dev and a single host that publishes the compose ports directly.
# For TLS / a reverse proxy (https, subdomains, no ports) set the full URLs
# below explicitly instead of relying on APP_HOST.
#
# Internal service-to-service URLs (MONGO_URI, HANKO_API_URL, OPENINARY_URL,
# SMTP_HOST) intentionally use compose service names and must NOT use APP_HOST.
APP_HOST=localhost

# -----------------------------------------------------------------------------
# Hanko Auth
# -----------------------------------------------------------------------------
# Hanko connects to the auth-db using POSTGRES_USER / POSTGRES_PASSWORD /
# POSTGRES_DB above (mapped onto Hanko's DATABASE_* env vars in the compose
# files), so there is no separate Hanko DB password to keep in sync.
# The WebAuthn RP id/origins come from APP_HOST + APP_BASE_URL — see the Public
# Host / Origin section above. To allow MULTIPLE WebAuthn origins, edit the auth
# service's `environment:` block in the compose file (WEBAUTHN_RELYING_PARTY_ORIGINS
# accepts a comma-separated list). Do NOT put a list in APP_BASE_URL — the API
# builds single links from it (see the API section).
#
# CORS is set to a static wildcard in the auth service's `environment:` block in
# the compose files (SERVER_PUBLIC_CORS_ALLOW_ORIGINS / _UNSAFE_WILDCARD_ORIGIN_ALLOWED),
# so the auth API accepts any browser origin regardless of APP_HOST/APP_BASE_URL.
# It is intentionally NOT derived from APP_BASE_URL — an empty/mismatched value
# there was the original cause of the CORS errors. To lock CORS down, set those
# two env vars (and hanko/config.yaml) to your exact web origin(s).
#
# HANKO_SECRETS_KEYS signs Hanko's session JWTs — set a strong random string of at
# least 16 characters. If unset, Hanko uses a well-known default key (insecure).
HANKO_SECRETS_KEYS=very-secret-key-at-least-16-chars

# -----------------------------------------------------------------------------
# Openinary (Image Hosting)
# -----------------------------------------------------------------------------
# Generate an API key after first run from http://localhost:3002
OPENINARY_API_KEY=
# Secret used by Openinary to sign delivery URLs (REQUIRED — server exits without it).
# Generate a strong value: `openssl rand -base64 32`
API_SECRET=replace-me-with-openssl-rand-base64-32
# Better Auth secret (MUST be at least 32 random characters).
# Generate: `openssl rand -base64 32`
BETTER_AUTH_SECRET=replace-me-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://${APP_HOST}:3002
MODE=fullstack

# -----------------------------------------------------------------------------
# API
# -----------------------------------------------------------------------------
# Internal: container-to-container, use compose service names (not APP_HOST).
MONGO_URI=mongodb://api-db:27017/bdt
HANKO_API_URL=http://auth:8000
# Public web origin (single URL). Used by the API for user-facing links AND
# injected into Hanko as WebAuthn origins + CORS allow_origins (see Public Host /
# Origin above). Keep it a single origin — the API builds links from it.
APP_BASE_URL=http://${APP_HOST}:3000
UPLOAD_PROVIDER=openinary
# Internal: container-to-container, uses the compose service name (not APP_HOST).
OPENINARY_URL=http://openinary:3000
OPENINARY_PUBLIC_URL=http://${APP_HOST}:3002

# -----------------------------------------------------------------------------
# SMTP (Defaults to mailslurper for local dev; override for production)
# -----------------------------------------------------------------------------
SMTP_HOST=mailslurper
SMTP_PORT=2500
SMTP_SECURE=false
SMTP_USER=test
SMTP_PASS=test
SMTP_FROM=no-reply@example.com

# -----------------------------------------------------------------------------
# Web (Next.js) — public URLs the browser calls, derived from APP_HOST.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_HANKO_API_URL=http://${APP_HOST}:8000
NEXT_PUBLIC_BDT_API_URL=http://${APP_HOST}:3001
